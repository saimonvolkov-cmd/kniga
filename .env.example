# Скопируйте в .env и заполните своими значениями.
# Файл .env добавлен в .gitignore — секреты никогда не попадут в репозиторий.
#
# Где взять:
#  1. Yandex Cloud → каталог → сервисный аккаунт с ролями
#     ai.languageModels.user (YandexGPT) и ai.imageGeneration.user (YandexART);
#  2. API-ключ с областью действия yc.ai.foundationModels.execute
#     (показывается ОДИН раз при создании — сохраните сразу);
#  3. YANDEX_FOLDER_ID — идентификатор каталога (обычно b1g…).

YANDEX_API_KEY=<ваш сервисный API-ключ>
YANDEX_FOLDER_ID=<идентификатор каталога>

# ── Фронтенд (Vite подхватывает при сборке) ──────────────────────────────
# Адреса Yandex Cloud Functions. Если не заданы, фронтенд использует
# продакшен-значения по умолчанию из src/lib/api.ts — эти переменные нужны
# только чтобы подменить адреса (стейджинг/новый деплой) без правки кода.
#
# VITE_YANDEX_TEXT_FN_URL=https://functions.yandexcloud.net/d4espk5f9san6nbhboij
# VITE_YANDEX_IMAGE_FN_URL=https://functions.yandexcloud.net/d4eksf6i4b1906srn22e
# VITE_YANDEX_HEALTH_FN_URL=https://functions.yandexcloud.net/d4ea980tmec1e5pdai3n
#
# Локальный Express-прокси (альтернатива Cloud Functions для разработки):
# VITE_YANDEX_PROXY_URL=http://localhost:3001

# ── Сервер (локальный прокси, node server/server.js) ─────────────────────
# Необязательные:
# PORT=3001
# YANDEX_TEXT_MODEL=yandexgpt
# YANDEX_ART_MODEL=yandex-art
