# Скопируйте в .env и заполните своими значениями.
# Файл .env добавлен в .gitignore — секреты никогда не попадут в репозиторий.
#
# Где взять:
#  1. Yandex Cloud → каталог → сервисный аккаунт с ролями
#     ai.languageModels.user (YandexGPT) и ai.imageGeneration.user (YandexART);
#  2. API-ключ с областью действия yc.ai.foundationModels.execute
#     (показывается ОДИН раз при создании — сохраните сразу);
#  3. YANDEX_FOLDER_ID — идентификатор каталога (обычно b1g…).

YANDEX_API_KEY=<ваш сервисный API-ключ>
YANDEX_FOLDER_ID=<идентификатор каталога>

# Необязательные:
# PORT=3001
# YANDEX_TEXT_MODEL=yandexgpt
# YANDEX_ART_MODEL=yandex-art
